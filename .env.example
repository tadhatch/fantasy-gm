ESPN_LEAGUE_ID=#########
ESPN_TEAM_ID=#
ESPN_SEASON=####
ESPN_SWID=
ESPN_S2=
ESPN_POLL_SECONDS=2
OPENAI_API_KEY=
FANTASY_GM_FAVORITE_TEAM=DET
FANTASY_GM_FANDOM_WEIGHT=1.5
FANTASY_GM_CONTEXT_MODEL=gpt-5.6-luna
FANTASY_GM_DEEP_DIVE_MODEL=gpt-5.6-terra
FANTASY_GM_DEEP_DIVE_THRESHOLD=0.55
FANTASY_GM_MAX_DEEP_DIVES_PER_REFRESH=8
FANTASY_GM_AUTO_SELECT=false

# Optional: model for the waiver pipeline's final GM-decision stage
# (fantasy_gm/waiver/pipeline.py). Defaults to FANTASY_GM_CONTEXT_MODEL
# if unset — override here if you want that last, strict, small call on
# a cheaper/faster model than the reasoning stages before it.
FANTASY_GM_GM_DECISION_MODEL=

# Durable store for player evaluations (context/postgres_store.py). Points
# at a Postgres instance. On Railway, set this directly on each service
# (e.g. DATABASE_URL=${{Postgres.DATABASE_URL}}) rather than through a
# project Shared Variable. Locally, use the Postgres plugin's public
# connection string instead.
DATABASE_URL=

# Recurring player-evaluation worker: off-field "feeling" signal
# (contracts, holdouts, legal, personal life, distractions — NOT
# on-field stats) for the roster + top free agents, kept as a shared
# inventory other workers (lineup, waiver, trade) read instead of
# researching players themselves. One broad web-search scan across the
# whole pool per run, escalating to a real per-player deep dive only for
# whatever it flags — not one call per player, so the budget stays
# small. Supervisor-only settings; the dispatched worker itself just
# receives these as CLI args.
FANTASY_GM_EVALUATION_ENABLED=true
FANTASY_GM_EVALUATION_INTERVAL_HOURS=24
FANTASY_GM_EVALUATION_POOL_SIZE=50
FANTASY_GM_EVALUATION_MAX_CALLS=5
FANTASY_GM_EVALUATION_FRESHNESS_HOURS=24

# Recurring lineup worker: no LLM calls of its own — reads ESPN's own
# weekly projections plus whatever the evaluation worker already cached.
# Scheduled off the real NFL schedule (nflreadpy), not a fixed interval —
# runs once per wave of kickoffs (LINEUP_CHECKPOINT_BUFFER_MINUTES in
# supervisor.py before the earliest game of each slate), since games now
# spread across most weekdays in a season. Submits via the transactions
# client, which shadows unless FANTASY_GM_TRANSACTIONS_MODE is live AND
# FANTASY_GM_LINEUP_CONFIRM is also true — keep both off until you trust
# its output.
FANTASY_GM_LINEUP_ENABLED=true
FANTASY_GM_LINEUP_CONFIRM=false

# Lineup availability gate (fantasy_gm/lineup/availability.py +
# validator.py). Deterministic, no LLM: an unavailable player (OUT, IR,
# suspended, bye, not on an NFL roster, or missing/stale data) is never
# submitted as a starter, and every lineup is re-validated against a
# fresh ESPN read immediately before submission.
#
# "Confirmed active" is inferred from ESPN: a QUESTIONABLE/DOUBTFUL
# status read at or after (kickoff - INACTIVES_LEAD) that hasn't flipped
# to OUT. Before that, QUESTIONABLE starts provisionally (flagged for
# revalidation) and DOUBTFUL can't start.
FANTASY_GM_INACTIVES_LEAD_MINUTES=90
# ESPN data older than this can't confirm anyone's availability.
FANTASY_GM_AVAILABILITY_MAX_AGE_MINUTES=20
# The lineup worker runs this many minutes before EACH distinct kickoff
# time -- the final check for that game's players. Keep it below
# INACTIVES_LEAD (so it runs after inactives) and comfortably above
# Railway's worker startup time (so it finishes before lock).
FANTASY_GM_LINEUP_CHECKPOINT_BUFFER_MINUTES=75
# Plan -> validate -> fresh re-read -> revalidate cycles before giving
# up and submitting nothing (logged CRITICAL as lineup.no_legal_lineup).
FANTASY_GM_LINEUP_MAX_REPAIR_ATTEMPTS=3
# Supervisor-side, LLM-free check between checkpoints: if an unlocked
# starter can't start (new injury, processed waiver/trade) or a starting
# slot is empty with a startable bench player available, it dispatches
# the lineup worker -- once per distinct problem per scoring period.
FANTASY_GM_LINEUP_HEALTH_CHECK_MINUTES=30

# Emergency roster repair (fantasy_gm/repair) -- runs inside the lineup
# worker whenever a required starting slot can't be filled by anyone on
# the roster this week (and on demand: `fantasy-gm worker repair`).
# Deterministic, no LLM. Searches free agents/waivers for players who
# can actually play in time (a waiver claim must clear
# REPAIR_WAIVER_LEAD_MINUTES before his kickoff), uses an open roster
# spot or IR slot before dropping anyone, never drops locked/
# undroppable players or anyone whose loss opens another hole, and won't
# cut a player worth more (rest-of-season estimate) than the fill gains.
# Same double gate as every transaction: shadow unless
# FANTASY_GM_TRANSACTIONS_MODE=live AND FANTASY_GM_REPAIR_CONFIRM=true.
FANTASY_GM_REPAIR_ENABLED=true
FANTASY_GM_REPAIR_CONFIRM=false
# best_value (default): weakest expendable player at the affected
#   position, unless someone elsewhere is cheaper by more than
#   REPAIR_SAME_POSITION_MARGIN rest-of-season points.
# same_position: affected position only (falls back if none droppable).
# lowest_ros: lowest rest-of-season estimate anywhere.
FANTASY_GM_REPAIR_DROP_STRATEGY=best_value
FANTASY_GM_REPAIR_SAME_POSITION_MARGIN=10
# Minimum estimated roster value gain (add ROS + this week's fill -
# drop ROS) for a drop to happen. Raise it to protect your roster from
# one-week fills more aggressively.
FANTASY_GM_REPAIR_MIN_VALUE_DELTA=0
FANTASY_GM_REPAIR_WAIVER_LEAD_MINUTES=45
# Injury statuses your league allows in the IR slot (ESPN default).
FANTASY_GM_IR_ELIGIBLE_STATUSES=INJURY_RESERVE,OUT

# Python log level for CLI/worker processes (structured lines look like
# `event=lineup.move player=... from_slot=... outcome=...`).
FANTASY_GM_LOG_LEVEL=INFO

# Recurring waiver worker: roster evaluation -> free-agent screening ->
# deep evaluation/decision -> GM decision (4 calls plus up to
# FANTASY_GM_WAIVER_DEEP_DIVE_BUDGET more for player-specific fresh
# research the decision stage explicitly asks for). Runs once per
# calendar day, WAIVER_CHECKPOINT_BUFFER_MINUTES (supervisor.py) after
# this league's own waiverProcessHour -- read live from ESPN's own
# settings, not hardcoded, so it stays correct if a commissioner changes
# it. Running just after that cutoff means each run sees a freshly-
# resolved free-agent pool and gets maximum standing before the next
# processing window, on every day including ones this league doesn't
# actually process waivers on (harmless -- a claim just waits for the
# next real one). Submits via the
# transactions client, which shadows unless FANTASY_GM_TRANSACTIONS_MODE
# is live AND FANTASY_GM_WAIVER_CONFIRM is also true -- same double-gate
# pattern as the lineup worker. Keep FANTASY_GM_WAIVER_CONFIRM off until
# you trust its decisions unattended.
FANTASY_GM_WAIVER_ENABLED=true
FANTASY_GM_WAIVER_CONFIRM=false
FANTASY_GM_WAIVER_POOL_SIZE=60
FANTASY_GM_WAIVER_SHORTLIST_SIZE=15
FANTASY_GM_WAIVER_DEEP_DIVE_BUDGET=3

# Trade workers. The outgoing worker (fantasy-gm worker trade) is
# manual-only for now -- not on the supervisor's schedule. The incoming
# side polls every supervisor cycle for trade proposals other teams have
# sent us (fantasy_gm/trade/incoming.py) and logs each not-yet-decided
# one it sees, regardless of the setting below. Both pipelines shadow
# unless FANTASY_GM_TRANSACTIONS_MODE is live AND --confirm is also
# passed to that specific run -- same double-gate pattern as lineup/
# waiver. For the automated incoming-trade dispatch specifically, that
# second gate is FANTASY_GM_INCOMING_TRADE_CONFIRM below. This was a
# deliberate, explicit policy change (like waiver's), not a default flip.
FANTASY_GM_INCOMING_TRADE_ENABLED=true
FANTASY_GM_INCOMING_TRADE_DEEP_DIVE_BUDGET=1
FANTASY_GM_INCOMING_TRADE_CONFIRM=false

# Separate from FANTASY_GM_INCOMING_TRADE_ENABLED above: that one gates
# detection (and its log line) entirely; this one only gates whether a
# detected trade also gets an evaluation worker dispatched automatically.
# Set to false to confirm the supervisor can see a real incoming trade
# (via its log line) without it also acting on one -- useful for a first
# live test before trusting the evaluation step.
FANTASY_GM_INCOMING_TRADE_AUTO_DISPATCH=true

# Supervisor test-worker integration test (Railway lifecycle smoke test)
FANTASY_GM_TEST_WORKER_ON_START=false
FANTASY_GM_TEST_WORKER_SLEEP_SECONDS=240
FANTASY_GM_SUPERVISOR_POLL_SECONDS=60

# Roster/waiver/trade transactions — "shadow" logs the payload it would
# send to ESPN without submitting it; "live" actually submits (each CLI
# call additionally requires --confirm). Keep this at "shadow" until the
# reverse-engineered payload shapes in espn/transactions.py have been
# verified against a real browser capture.
FANTASY_GM_TRANSACTIONS_MODE=shadow

# Chatbot settings
# Bump FANTASY_GM_CHATBOT_VERSION whenever the chatbot's provisioning
# changes (a new required variable, a different start command) — the
# supervisor recreates the service from scratch if the deployed version
# (tracked in Postgres) doesn't match this.
FANTASY_GM_CHATBOT_VERSION=1
FANTASY_GM_CHATBOT_ENABLED=true
FANTASY_GM_CHATBOT_MODE=shadow
FANTASY_GM_CHATBOT_MODEL=gpt-5.6-luna
FANTASY_GM_CHAT_TOPIC_ID=
FANTASY_GM_CHAT_POLL_SECONDS=3
FANTASY_GM_CHAT_DRAFT_REFRESH_SECONDS=15

# Spam controls
FANTASY_GM_CHAT_MAX_ACTIONS_PER_MINUTE=3
FANTASY_GM_CHAT_MAX_REPLIES_PER_MINUTE=2
FANTASY_GM_CHAT_MAX_CHARS=280

# Context size
FANTASY_GM_CHAT_RECENT_MESSAGES=14
FANTASY_GM_CHAT_RECENT_PICKS=12

# ESPN reactions
FANTASY_GM_CHAT_REACTIONS=true

# Proactive comments are intentionally disabled in this package.
FANTASY_GM_CHAT_PROACTIVE=false

# Extra transport logging
FANTASY_GM_CHAT_DEBUG=false