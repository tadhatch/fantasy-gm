ESPN_LEAGUE_ID=#########
ESPN_TEAM_ID=#
ESPN_SEASON=####
ESPN_SWID=
ESPN_S2=
ESPN_POLL_SECONDS=2
OPENAI_API_KEY=
FANTASY_GM_FAVORITE_TEAM=DET
FANTASY_GM_FANDOM_WEIGHT=1.5
FANTASY_GM_CONTEXT_MODEL=gpt-5.6-luna
FANTASY_GM_DEEP_DIVE_MODEL=gpt-5.6-terra
FANTASY_GM_DEEP_DIVE_THRESHOLD=0.55
FANTASY_GM_MAX_DEEP_DIVES_PER_REFRESH=8
FANTASY_GM_AUTO_SELECT=false

# Optional: model for the waiver pipeline's final GM-decision stage
# (fantasy_gm/waiver/pipeline.py). Defaults to FANTASY_GM_CONTEXT_MODEL
# if unset — override here if you want that last, strict, small call on
# a cheaper/faster model than the reasoning stages before it.
FANTASY_GM_GM_DECISION_MODEL=

# Durable store for player evaluations (context/postgres_store.py). Points
# at a Postgres instance. On Railway, set this directly on each service
# (e.g. DATABASE_URL=${{Postgres.DATABASE_URL}}) rather than through a
# project Shared Variable. Locally, use the Postgres plugin's public
# connection string instead.
DATABASE_URL=

# Recurring player-evaluation worker: off-field "feeling" signal
# (contracts, holdouts, legal, personal life, distractions — NOT
# on-field stats) for the roster + top free agents, kept as a shared
# inventory other workers (lineup, waiver, trade) read instead of
# researching players themselves. One broad web-search scan across the
# whole pool per run, escalating to a real per-player deep dive only for
# whatever it flags — not one call per player, so the budget stays
# small. Supervisor-only settings; the dispatched worker itself just
# receives these as CLI args.
FANTASY_GM_EVALUATION_ENABLED=true
FANTASY_GM_EVALUATION_INTERVAL_HOURS=24
FANTASY_GM_EVALUATION_POOL_SIZE=50
FANTASY_GM_EVALUATION_MAX_CALLS=5
FANTASY_GM_EVALUATION_FRESHNESS_HOURS=24

# Supervisor test-worker integration test (Railway lifecycle smoke test)
FANTASY_GM_TEST_WORKER_ON_START=false
FANTASY_GM_TEST_WORKER_SLEEP_SECONDS=240
FANTASY_GM_SUPERVISOR_POLL_SECONDS=60

# Roster/waiver/trade transactions — "shadow" logs the payload it would
# send to ESPN without submitting it; "live" actually submits (each CLI
# call additionally requires --confirm). Keep this at "shadow" until the
# reverse-engineered payload shapes in espn/transactions.py have been
# verified against a real browser capture.
FANTASY_GM_TRANSACTIONS_MODE=shadow

# Chatbot settings
# Bump FANTASY_GM_CHATBOT_VERSION whenever the chatbot's provisioning
# changes (a new required variable, a different start command) — the
# supervisor recreates the service from scratch if the deployed version
# (tracked in Postgres) doesn't match this.
FANTASY_GM_CHATBOT_VERSION=1
FANTASY_GM_CHATBOT_ENABLED=true
FANTASY_GM_CHATBOT_MODE=shadow
FANTASY_GM_CHATBOT_MODEL=gpt-5.6-luna
FANTASY_GM_CHAT_TOPIC_ID=
FANTASY_GM_CHAT_POLL_SECONDS=3
FANTASY_GM_CHAT_DRAFT_REFRESH_SECONDS=15

# Spam controls
FANTASY_GM_CHAT_MAX_ACTIONS_PER_MINUTE=3
FANTASY_GM_CHAT_MAX_REPLIES_PER_MINUTE=2
FANTASY_GM_CHAT_MAX_CHARS=280

# Context size
FANTASY_GM_CHAT_RECENT_MESSAGES=14
FANTASY_GM_CHAT_RECENT_PICKS=12

# ESPN reactions
FANTASY_GM_CHAT_REACTIONS=true

# Proactive comments are intentionally disabled in this package.
FANTASY_GM_CHAT_PROACTIVE=false

# Extra transport logging
FANTASY_GM_CHAT_DEBUG=false